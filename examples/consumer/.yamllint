---
extends: "default"
rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start:
    present: true
  empty-lines:
    max: 2
    max-start: 0
    max-end: 0
  indentation:
    spaces: 2
    indent-sequences: true
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  quoted-strings:
    quote-type: "double"
    required: false
    allow-quoted-quotes: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: true
